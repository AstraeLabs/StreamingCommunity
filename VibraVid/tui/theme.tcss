/* VibraVid TUI theme — semantic tokens.
   Category colors mirror COLOR_MAP in VibraVid/cli/run.py. */

$cat-anime: red;
$cat-film_serie: yellow;
$cat-serie: green;
$cat-song: #585858;
$cat-tor: blue;
$cat-global: magenta;

$accent: cyan;
$error: red;
$warning: yellow;
$success: green;

/* ── Home ─────────────────────────────────────────────────────────────── */

#sidebar {
    width: 22;
    dock: left;
    border-right: solid $primary-background-lighten-2;
    padding: 0 1;
}

#site-panel {
    width: 1fr;
    padding: 0 1;
}

.panel-title {
    text-style: bold;
    color: $accent;
    padding: 1 0 0 0;
}

.category-label {
    text-style: bold;
}

.cat-anime { color: $cat-anime; }
.cat-film_serie { color: $cat-film_serie; }
.cat-serie { color: $cat-serie; }
.cat-song { color: $cat-song; }
.cat-tor { color: $cat-tor; }
.cat-global { color: $cat-global; }

.site-source {
    color: $text-muted;
}

/* ── Placeholder / Help ───────────────────────────────────────────────── */

PlaceholderScreen, HelpScreen {
    align: center middle;
}

#placeholder-box, #help-box {
    width: 64;
    max-width: 90%;
    height: auto;
    border: solid $accent;
    padding: 1 2;
    background: $surface;
}

.placeholder-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

.placeholder-milestone {
    color: $warning;
    padding-top: 1;
}

.placeholder-hint {
    color: $text-muted;
    padding-top: 1;
}

/* ── Search ───────────────────────────────────────────────────────────── */

#search-panel {
    padding: 0 1;
}

#query, #year {
    margin-bottom: 1;
}

#search-loading {
    height: 3;
}

#search-status {
    color: $text-muted;
    padding: 0 1;
}

FuzzyList {
    height: 1fr;
}

#fuzzy-input {
    dock: top;
}

#fuzzy-list {
    height: 1fr;
}

/* ── Detail ───────────────────────────────────────────────────────────── */

#detail-panel {
    padding: 0 2;
}

.detail-title {
    text-style: bold;
    color: $accent;
    padding-top: 1;
}

.detail-meta {
    color: $text-muted;
}

#series-area {
    height: 1fr;
    padding-top: 1;
}

#seasons-loading {
    height: 3;
}

#series-browser {
    height: 1fr;
}

#seasons-box {
    width: 24;
    border-right: solid $primary-background-lighten-2;
}

#episodes-box {
    width: 1fr;
    padding: 0 1;
}

.dsl-preview {
    color: $warning;
    padding: 1 0;
}

#actions-row {
    height: auto;
    padding: 1 0;
}

#actions-row Button {
    margin-right: 2;
}

/* ── Downloads ────────────────────────────────────────────────────────── */

#downloads-panel {
    padding: 0 1;
}

#downloads-table {
    height: 1fr;
    max-height: 40%;
}

#tasks-table {
    height: 1fr;
}

#downloads-actions {
    height: auto;
    padding: 1 0;
}

#downloads-actions Button {
    margin-right: 2;
}

/* ── Settings ─────────────────────────────────────────────────────────── */

#settings-sidebar {
    width: 26;
    dock: left;
    border-right: solid $primary-background-lighten-2;
    padding: 0 1;
}

#settings-content {
    width: 1fr;
    padding: 0 1;
}

#settings-form {
    height: 1fr;
    padding: 1 0;
}

.settings-banner {
    border: solid $warning;
    color: $warning;
    padding: 1;
    margin-bottom: 1;
}

.settings-field {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

.field-label {
    width: 32;
    text-style: bold;
    color: $accent;
}

.sub-title {
    text-style: bold;
    color: $accent;
    padding-top: 1;
    padding-bottom: 1;
}

#settings-actions {
    height: auto;
    padding: 1 0;
    align: left middle;
}

#settings-actions Button {
    margin-right: 1;
}

#settings-status {
    padding-left: 1;
}

/* ── System ───────────────────────────────────────────────────────────── */

#tab-deps, #tab-logs, #tab-updates {
    padding: 0 1;
}

#deps-table {
    height: auto;
    max-height: 12;
    margin-bottom: 1;
}

#drm-box {
    height: auto;
    padding: 1;
    border: solid $primary-background-lighten-2;
    margin-bottom: 1;
}

#log-control-bar {
    height: auto;
    margin-bottom: 1;
    align: left middle;
}

#log-control-bar Button {
    margin-left: 2;
}

#log-layout {
    height: 1fr;
}

#log-file-list {
    width: 30;
    dock: left;
    border-right: solid $primary-background-lighten-2;
}

#log-viewer {
    width: 1fr;
    height: 1fr;
    border: solid $primary-background-lighten-2;
    background: $surface;
}

#update-box {
    height: 1fr;
    padding: 1;
}

#system-info-text {
    margin-bottom: 1;
}

#update-status {
    padding-top: 1;
}

/* ── Queue ────────────────────────────────────────────────────────────── */

#queue-panel {
    padding: 0 1;
}

#queue-table {
    height: 1fr;
    max-height: 50%;
}

.queue-detail-box {
    height: 5;
    border: solid $accent;
    background: $surface;
    padding: 0 1;
}

#queue-actions {
    height: auto;
    padding: 1 0;
}

#queue-actions Button {
    margin-right: 2;
}

/* ── History ──────────────────────────────────────────────────────────── */

#history-panel {
    padding: 0 1;
}

#history-table {
    height: 1fr;
    max-height: 50%;
}

.history-detail-box {
    height: 5;
    border: solid $accent;
    background: $surface;
    padding: 0 1;
}

#history-actions {
    height: auto;
    padding: 1 0;
}

#history-actions Button {
    margin-right: 2;
}

/* ── Enqueue Modal ────────────────────────────────────────────────────── */

EnqueueModal {
    align: center middle;
}

#enqueue-modal-box {
    width: 64;
    max-width: 90%;
    height: auto;
    border: solid $accent;
    padding: 1 2;
    background: $surface;
}

#enqueue-input {
    margin: 1 0;
}

#modal-buttons {
    height: auto;
    padding-top: 1;
}

#modal-buttons Button {
    margin-right: 2;
}
